# Copy to .env for Prisma CLI and Next.js. Replace placeholders locally.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Exact UUID of the sole approved user, created manually in Supabase Auth.
JARVIS_OWNER_ID=
# Bootstrap with the Supabase transaction-pooler URI; db:provision replaces
# this with generated jarvis_app credentials. Add pgbouncer=true,
# connection_limit=1 and sslmode=require. Never commit the real .env.
DATABASE_URL=
# Admin direct/session-pooler URI for migrations/provisioning only; SSL required.
DIRECT_URL=
# Explicitly opt into synthetic /demo locally. Never allowed in production.
JARVIS_DEMO_MODE=false
# Seed only: both must be true to write synthetic records to a development DB.
JARVIS_SEED_SYNTHETIC=false
JARVIS_DATABASE_ENV=development

# Telegram Phase 3: local polling is opt-in; never share these values in chat.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_USER_ID=
TELEGRAM_OWNER_CHAT_ID=
# Required only for a hosted HTTPS webhook; polling does not need this.
TELEGRAM_WEBHOOK_SECRET=

# Required before storing provider credentials. Choose local key custody/backup first.
# 32 cryptographically random bytes represented as 64 hex characters; never share in chat.
JARVIS_CONNECTOR_ENCRYPTION_KEY=

# Optional interpretation/composition. Requires consent, owner enablement and API billing.
JARVIS_AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=

# Explicitly activate only after reviewing notification preferences.
JARVIS_NOTIFICATIONS_ENABLED=false

# Owner-controlled backup key. Leave blank until key custody/storage are chosen.
JARVIS_BACKUP_KEY=

# Optional mandatory enrollment. Verified factors are enforced even when false.
JARVIS_REQUIRE_MFA=false

# Optional Chase transaction history. Keep disabled until owner setup is complete.
PLAID_ENABLED=false
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_TRIAL_CONFIRMED=false
PLAID_REDIRECT_URI=

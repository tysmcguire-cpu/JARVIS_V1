generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  notificationRules         NotificationRule[]
  notificationJobs          NotificationJob[]
  notificationDeliveries    NotificationDelivery[]
  aiConversations           AiConversation[]
  aiSources                 AiSourceReference[]
  apiConnections            ApiConnection[]
  syncLogs                  SyncLog[]
  externalRecords           ExternalRecord[]
  csvBatches                CsvImportBatch[]
  csvKeys                   CsvImportKey[]
  telegramIdentity          TelegramIdentity?
  telegramMessages          TelegramMessage[]
  id                        String                 @id @db.Uuid
  singleton                 Boolean                @unique @default(true)
  displayName               String                 @default("Owner") @db.VarChar(100)
  synthetic                 Boolean                @default(false)
  createdAt                 DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt                 DateTime               @updatedAt @db.Timestamptz(6)
  settings                  UserSettings?
  auditLogs                 AuditLog[]
  trackingFinancialAccount  FinancialAccount[]
  trackingCategory          Category[]
  trackingTransaction       Transaction[]
  trackingBudget            Budget[]
  trackingBudgetCategory    BudgetCategory[]
  trackingRecurringExpense  RecurringExpense[]
  trackingCourse            Course[]
  trackingAssignment        Assignment[]
  trackingExam              Exam[]
  trackingGrade             Grade[]
  trackingStudySession      StudySession[]
  trackingEvent             Event[]
  trackingTask              Task[]
  trackingReminder          Reminder[]
  trackingCareerApplication CareerApplication[]
  trackingContact           Contact[]
  trackingFollowUp          FollowUp[]
  trackingProject           Project[]
  trackingMilestone         Milestone[]
  trackingProjectActivity   ProjectActivity[]
  trackingGoal              Goal[]
  trackingHabit             Habit[]
  trackingHabitEntry        HabitEntry[]
  trackingNote              Note[]
}

model AiConversation {
  id        String              @id @default(uuid()) @db.Uuid
  userId    String              @db.Uuid
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  question  String              @db.VarChar(1000)
  query     Json
  answer    Json?
  status    String              @default("pending") @db.VarChar(20)
  createdAt DateTime            @default(now()) @db.Timestamptz(6)
  sources   AiSourceReference[]

  @@unique([id, userId])
  @@index([userId, createdAt], map: "AiConversation_owner_created")
}

model AiSourceReference {
  id              String         @id @default(uuid()) @db.Uuid
  userId          String         @db.Uuid
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId  String         @db.Uuid
  conversation    AiConversation @relation(fields: [conversationId, userId], references: [id, userId], onDelete: Cascade)
  reference       String         @db.VarChar(150)
  label           String         @db.VarChar(300)
  href            String         @db.VarChar(300)
  sourceUpdatedAt DateTime       @db.Timestamptz(6)
  fetchedAt       DateTime       @db.Timestamptz(6)

  @@unique([conversationId, reference])
  @@index([userId, conversationId], map: "AiSourceReference_owner")
}

model UserSettings {
  background String @default("current") @db.VarChar(10)
  primaryColor String @default("#69d8f3") @db.VarChar(7)
  secondaryColor String @default("#b1a0ff") @db.VarChar(7)
  notificationTelegramEnabled Boolean  @default(false)
  userId                      String   @id @db.Uuid
  user                        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  timezone                    String   @default("America/Chicago") @db.VarChar(100)
  currency                    String   @default("USD") @db.Char(3)
  weeklyReviewEnabled         Boolean  @default(true)
  weeklyReviewDay             Int      @default(0)
  weeklyReviewTime            String   @default("18:00") @db.VarChar(5)
  deadlineReminders           Boolean  @default(true)
  financialAlerts             Boolean  @default(true)
  morningBriefingEnabled      Boolean  @default(false)
  morningBriefingTime         String   @default("08:00") @db.VarChar(5)
  unsolicitedAiEnabled        Boolean  @default(false)
  createdAt                   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt                   DateTime @updatedAt @db.Timestamptz(6)
}

model NotificationRule {
  config         Json              @default("{}")
  id             String            @id @default(uuid()) @db.Uuid
  userId         String            @db.Uuid
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind           String            @db.VarChar(20)
  version        Int               @default(1)
  thresholdMinor BigInt?
  currency       String            @default("USD") @db.Char(3)
  leadDays       Int               @default(1)
  time           String            @default("09:00") @db.VarChar(5)
  lastScannedAt  DateTime?         @db.Timestamptz(6)
  createdAt      DateTime          @default(now()) @db.Timestamptz(6)
  jobs           NotificationJob[]

  @@unique([userId, kind])
  @@unique([id, userId])
}

model NotificationJob {
  id            String                 @id @default(uuid()) @db.Uuid
  userId        String                 @db.Uuid
  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  ruleId        String                 @db.Uuid
  rule          NotificationRule       @relation(fields: [ruleId, userId], references: [id, userId], onDelete: Cascade)
  ruleVersion   Int
  dedupeKey     String                 @db.VarChar(200)
  payload       Json
  entity        String?                @db.VarChar(40)
  recordId      String?                @db.Uuid
  dueDate       DateTime?              @db.Date
  status        String                 @default("queued") @db.VarChar(20)
  attempts      Int                    @default(0)
  maxAttempts   Int                    @default(5)
  scheduledAt   DateTime               @db.Timestamptz(6)
  nextAttemptAt DateTime               @db.Timestamptz(6)
  expiresAt     DateTime               @db.Timestamptz(6)
  leaseToken    String?                @db.Uuid
  leaseUntil    DateTime?              @db.Timestamptz(6)
  readAt        DateTime?              @db.Timestamptz(6)
  createdAt     DateTime               @default(now()) @db.Timestamptz(6)
  deliveries    NotificationDelivery[]

  @@unique([userId, dedupeKey])
  @@unique([id, userId])
  @@index([userId, entity, recordId])
  @@index([userId, status, nextAttemptAt], map: "NotificationJob_due")
}

model NotificationDelivery {
  id        String          @id @default(uuid()) @db.Uuid
  userId    String          @db.Uuid
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId     String          @db.Uuid
  job       NotificationJob @relation(fields: [jobId, userId], references: [id, userId], onDelete: Cascade)
  channel   String          @db.VarChar(20)
  attempt   Int
  outcome   String          @db.VarChar(20)
  code      String?         @db.VarChar(40)
  createdAt DateTime        @default(now()) @db.Timestamptz(6)

  @@unique([jobId, channel, attempt])
  @@index([userId, jobId], map: "NotificationDelivery_owner")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String   @db.VarChar(100)
  outcome   String   @db.VarChar(20)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([userId, createdAt])
}

model FinancialAccount {
  csvBatches                        CsvImportBatch[]
  csvKeys                           CsvImportKey[]
  id                                String             @id @default(uuid()) @db.Uuid
  userId                            String             @db.Uuid
  user                              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt                         DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt                         DateTime           @updatedAt @db.Timestamptz(6)
  title                             String             @db.VarChar(200)
  currency                          String             @db.VarChar(200)
  openingBalance                    BigInt
  childrenTransactionaccountId      Transaction[]      @relation("Transaction_accountId")
  childrenRecurringExpenseaccountId RecurringExpense[] @relation("RecurringExpense_accountId")

  @@unique([id, userId])
  @@index([userId, updatedAt])
}

model Category {
  id                                 String             @id @default(uuid()) @db.Uuid
  userId                             String             @db.Uuid
  user                               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt                          DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt                          DateTime           @updatedAt @db.Timestamptz(6)
  title                              String             @db.VarChar(200)
  kind                               String             @db.VarChar(200)
  childrenTransactioncategoryId      Transaction[]      @relation("Transaction_categoryId")
  childrenBudgetCategorycategoryId   BudgetCategory[]   @relation("BudgetCategory_categoryId")
  childrenRecurringExpensecategoryId RecurringExpense[] @relation("RecurringExpense_categoryId")

  @@unique([id, userId])
  @@index([userId, updatedAt])
}

model Transaction {
  csvBatchId       String?          @db.Uuid
  csvBatch         CsvImportBatch?  @relation(fields: [csvBatchId, userId], references: [id, userId], onDelete: NoAction, onUpdate: NoAction)
  id               String           @id @default(uuid()) @db.Uuid
  userId           String           @db.Uuid
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt        DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(6)
  title            String           @db.VarChar(200)
  accountId        String           @db.Uuid
  parentaccountId  FinancialAccount @relation("Transaction_accountId", fields: [accountId, userId], references: [id, userId], onDelete: NoAction, onUpdate: NoAction)
  categoryId       String           @db.Uuid
  parentcategoryId Category         @relation("Transaction_categoryId", fields: [categoryId, userId], references: [id, userId], onDelete: NoAction, onUpdate: NoAction)
  amount           BigInt
  date             DateTime         @db.Date

  @@unique([id, userId])
  @@index([userId, updatedAt])
  @@index([userId, accountId])
  @@index([userId, categoryId])
  @@index([userId, date])
}

model Budget {
  id                             String           @id @default(uuid()) @db.Uuid
  userId                         String           @db.Uuid
  user                           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt                      DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt                      DateTime         @updatedAt @db.Timestamptz(6)
  title                          String           @db.VarChar(200)
  currency                       String           @db.VarChar(200)
  startDate                      DateTime         @db.Date
  endDate                        DateTime         @db.Date
  childrenBudgetCategorybudgetId BudgetCategory[] @relation("BudgetCategory_budgetId")

  @@unique([id, userId])
  @@index([userId, updatedAt])
  @@index([userId, startDate])
  @@index([userId, endDate])
}

model BudgetCategory {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @db.Uuid
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @db.Timestamptz(6)
  title            String   @db.VarChar(200)
  budgetId         String   @db.Uuid
  parentbudgetId   Budget   @relation("BudgetCategory_budgetId", fields: [budgetId, userId], references: [id, userId], onDelete: NoAction, onUpdate: NoAction)
  categoryId       String   @db.Uuid
  parentcategoryId Category @relation("BudgetCategory_categoryId", fields: [categoryId, userId], references: [id, userId], onDelete: NoAction, onUpdate: NoAction)
  limitAmount      BigInt

  @@unique([id, userId])
  @@unique([userId, budgetId, categoryId])
  @@index([userId, updatedAt])
  @@index([userId, budgetId])
  @@index([userId, categoryId])
}

model RecurringExpense {
  id               String           @id @default(uuid()) @db.Uuid
  userId           String           @db.Uuid
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt        DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(6)
  title            String           @db.VarChar(200)
  accountId        String           @db.Uuid
  parentaccountId  FinancialAccount @relation("RecurringExpense_accountId", fields: [accountId, userId], references: [id, userId], onDelete: NoAction, onUpdate: NoAction)
  categoryId       String           @db.Uuid
  parentcategoryId Category         @relation("RecurringExpense_categoryId", fields: [categoryId, userId], references: [id, userId], onDelete: NoAction, onUpdate: NoAction)
  amount           BigInt
  dueDate          DateTime         @db.Date
  frequency        String           @db.VarChar(200)

  @@unique([id, userId])
  @@index([userId, updatedAt])
  @@index([userId, accountId])
  @@index([userId, categoryId])
  @@index([userId, dueDate])
}

model Course {
  id                           String         @id @default(uuid()) @db.Uuid
  userId                       String         @db.Uuid
  user                         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt                    DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt                    DateTime       @updatedAt @db.Timestamptz(6)
  title                        String         @db.VarChar(200)
  code                         String         @db.VarChar(200)
  term                         String         @db.VarChar(200)
  instructor                   String         @db.VarChar(200)
  childrenAssignmentcourseId   Assignment[]   @relation("Assignment_courseId")
  childrenExamcourseId         Exam[]         @relation("Exam_courseId")
  childrenGradecourseId        Grade[]        @relation("Grade_courseId")
  childrenStudySessioncourseId StudySession[] @relation("StudySession_courseId")

  @@unique([id, userId])
  @@index([userId, updatedAt])
}

model Assignment {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)
  title          String   @db.VarChar(200)
  courseId       String   @db.Uuid
  parentcourseId Course   @relation("Assignment_courseId", fields: [courseId, userId], references: [id, userId], onDelete: NoAction, onUpdate: NoAction)
  dueDate        DateTime @db.Date
  status         String   @db.VarChar(200)
  pointsPossible Int

  @@unique([id, userId])
  @@index([userId, updatedAt])
  @@index([userId, courseId])
  @@index([userId, dueDate])
  @@index([userId, status])
}

model Exam {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)
  title          String   @db.VarChar(200)
  courseId       String   @db.Uuid
  parentcourseId Course   @relation("Exam_courseId", fields: [courseId, userId], references: [id, userId], onDelete: NoAction, onUpdate: NoAction)
  dueDate        DateTime @db.Date
  status         String   @db.VarChar(200)
  pointsPossible Int

  @@unique([id, userId])
  @@index([userId, updatedAt])
  @@index([userId, courseId])
  @@index([userId, dueDate])
  @@index([userId, status])
}

model Grade {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)
  title          String   @db.VarChar(200)
  courseId       String   @db.Uuid
  parentcourseId Course   @relation("Grade_courseId", fields: [courseId, userId], references: [id, userId], onDelete: NoAction, onUpdate: NoAction)
  pointsEarned   Int
  pointsPossible Int
  date           DateTime @db.Date

  @@unique([id, userId])
  @@index([userId, updatedAt])
  @@index([userId, courseId])
  @@index([userId, date])
}

model StudySession {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)
  title          String   @db.VarChar(200)
  courseId       String   @db.Uuid
  parentcourseId Course   @relation("StudySession_courseId", fields: [courseId, userId], references: [id, userId], onDelete: NoAction, onUpdate: NoAction)
  date           DateTime @db.Date
  minutes        Int

  @@unique([id, userId])
  @@index([userId, updatedAt])
  @@index([userId, courseId])
  @@index([userId, date])
}

model Event {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  title     String   @db.VarChar(200)
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  startTime String   @db.VarChar(200)
  endTime   String   @db.VarChar(200)
  location  String   @db.VarChar(200)

  @@unique([id, userId])
  @@index([userId, updatedAt])
  @@index([userId, startDate])
  @@index([userId, endDate])
}

model Task {
  id                     String     @id @default(uuid()) @db.Uuid
  userId                 String     @db.Uuid
  user                   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt              DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime   @updatedAt @db.Timestamptz(6)
  title                  String     @db.VarChar(200)
  dueDate                DateTime   @db.Date
  status                 String     @db.VarChar(200)
  priority               String     @db.VarChar(200)
  childrenRemindertaskId Reminder[] @relation("Reminder_taskId")

  @@unique([id, userId])
  @@index([userId, updatedAt])
  @@index([userId, dueDate])
  @@index([userId, status])
}

model Reminder {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)
  title        String   @db.VarChar(200)
  taskId       String   @db.Uuid
  parenttaskId Task     @relation("Reminder_taskId", fields: [taskId, userId], references: [id, userId], onDelete: NoAction, onUpdate: NoAction)
  dueDate      DateTime @db.Date
  time         String   @db.VarChar(200)

  @@unique([id, userId])
  @@index([userId, updatedAt])
  @@index([userId, taskId])
  @@index([userId, dueDate])
}

model CareerApplication {
  id                            String     @id @default(uuid()) @db.Uuid
  userId                        String     @db.Uuid
  user                          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt                     DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt                     DateTime   @updatedAt @db.Timestamptz(6)
  title                         String     @db.VarChar(200)
  company                       String     @db.VarChar(200)
  status                        String     @db.VarChar(200)
  date                          DateTime   @db.Date
  url                           String     @db.VarChar(200)
  childrenContactapplicationId  Contact[]  @relation("Contact_applicationId")
  childrenFollowUpapplicationId FollowUp[] @relation("FollowUp_applicationId")

  @@unique([id, userId])
  @@index([userId, updatedAt])
  @@index([userId, status])
  @@index([userId, date])
}

model Contact {
  id                  String            @id @default(uuid()) @db.Uuid
  userId              String            @db.Uuid
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt           DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime          @updatedAt @db.Timestamptz(6)
  title               String            @db.VarChar(200)
  applicationId       String            @db.Uuid
  parentapplicationId CareerApplication @relation("Contact_applicationId", fields: [applicationId, userId], references: [id, userId], onDelete: NoAction, onUpdate: NoAction)
  email               String            @db.VarChar(200)
  organization        String            @db.VarChar(200)

  @@unique([id, userId])
  @@index([userId, updatedAt])
  @@index([userId, applicationId])
}

model FollowUp {
  id                  String            @id @default(uuid()) @db.Uuid
  userId              String            @db.Uuid
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt           DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime          @updatedAt @db.Timestamptz(6)
  title               String            @db.VarChar(200)
  applicationId       String            @db.Uuid
  parentapplicationId CareerApplication @relation("FollowUp_applicationId", fields: [applicationId, userId], references: [id, userId], onDelete: NoAction, onUpdate: NoAction)
  dueDate             DateTime          @db.Date
  status              String            @db.VarChar(200)

  @@unique([id, userId])
  @@index([userId, updatedAt])
  @@index([userId, applicationId])
  @@index([userId, dueDate])
  @@index([userId, status])
}

model Project {
  id                               String            @id @default(uuid()) @db.Uuid
  userId                           String            @db.Uuid
  user                             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt                        DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt                        DateTime          @updatedAt @db.Timestamptz(6)
  title                            String            @db.VarChar(200)
  description                      String            @db.VarChar(8000)
  status                           String            @db.VarChar(200)
  dueDate                          DateTime          @db.Date
  childrenMilestoneprojectId       Milestone[]       @relation("Milestone_projectId")
  childrenProjectActivityprojectId ProjectActivity[] @relation("ProjectActivity_projectId")

  @@unique([id, userId])
  @@index([userId, updatedAt])
  @@index([userId, status])
  @@index([userId, dueDate])
}

model Milestone {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)
  title           String   @db.VarChar(200)
  projectId       String   @db.Uuid
  parentprojectId Project  @relation("Milestone_projectId", fields: [projectId, userId], references: [id, userId], onDelete: NoAction, onUpdate: NoAction)
  dueDate         DateTime @db.Date
  status          String   @db.VarChar(200)

  @@unique([id, userId])
  @@index([userId, updatedAt])
  @@index([userId, projectId])
  @@index([userId, dueDate])
  @@index([userId, status])
}

model ProjectActivity {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)
  title           String   @db.VarChar(200)
  projectId       String   @db.Uuid
  parentprojectId Project  @relation("ProjectActivity_projectId", fields: [projectId, userId], references: [id, userId], onDelete: NoAction, onUpdate: NoAction)
  date            DateTime @db.Date
  description     String   @db.VarChar(8000)

  @@unique([id, userId])
  @@index([userId, updatedAt])
  @@index([userId, projectId])
  @@index([userId, date])
}

model Goal {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @db.Uuid
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt           DateTime @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @db.Timestamptz(6)
  title               String   @db.VarChar(200)
  target              Int
  current             Int
  unit                String   @db.VarChar(200)
  dueDate             DateTime @db.Date
  status              String   @db.VarChar(200)
  childrenHabitgoalId Habit[]  @relation("Habit_goalId")

  @@unique([id, userId])
  @@index([userId, updatedAt])
  @@index([userId, dueDate])
  @@index([userId, status])
}

model Habit {
  id                        String       @id @default(uuid()) @db.Uuid
  userId                    String       @db.Uuid
  user                      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt                 DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt                 DateTime     @updatedAt @db.Timestamptz(6)
  title                     String       @db.VarChar(200)
  goalId                    String       @db.Uuid
  parentgoalId              Goal         @relation("Habit_goalId", fields: [goalId, userId], references: [id, userId], onDelete: NoAction, onUpdate: NoAction)
  target                    Int
  unit                      String       @db.VarChar(200)
  childrenHabitEntryhabitId HabitEntry[] @relation("HabitEntry_habitId")

  @@unique([id, userId])
  @@index([userId, updatedAt])
  @@index([userId, goalId])
}

model HabitEntry {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)
  title         String   @db.VarChar(200)
  habitId       String   @db.Uuid
  parenthabitId Habit    @relation("HabitEntry_habitId", fields: [habitId, userId], references: [id, userId], onDelete: NoAction, onUpdate: NoAction)
  date          DateTime @db.Date
  value         Int

  @@unique([id, userId])
  @@unique([userId, habitId, date])
  @@index([userId, updatedAt])
  @@index([userId, habitId])
  @@index([userId, date])
}

model Note {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  title     String   @db.VarChar(200)
  content   String   @db.VarChar(8000)
  tag       String   @db.VarChar(200)

  @@unique([id, userId])
  @@index([userId, updatedAt])
}

model TelegramIdentity {
  userId           String    @id @db.Uuid
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  botId            String    @db.VarChar(30)
  telegramUserId   String    @db.VarChar(30)
  chatId           String    @db.VarChar(30)
  pairedAt         DateTime? @db.Timestamptz(6)
  pairingHash      String?   @db.VarChar(64)
  pairingExpiresAt DateTime? @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(6)
}

model TelegramMessage {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @db.Uuid
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  botId         String    @db.VarChar(30)
  updateId      BigInt
  command       String    @db.VarChar(30)
  reply         String    @db.VarChar(4096)
  entity        String?   @db.VarChar(30)
  recordId      String?   @db.Uuid
  recordVersion DateTime? @db.Timestamptz(6)
  undone        Boolean   @default(false)
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now()) @db.Timestamptz(6)
  leaseUntil    DateTime? @db.Timestamptz(6)
  canceledAt    DateTime? @db.Timestamptz(6)
  deliveredAt   DateTime? @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)

  @@unique([userId, botId, updateId])
  @@index([userId, createdAt])
  @@index([userId, deliveredAt, nextAttemptAt])
}

model ApiConnection {
  selection       Json             @default("{}")
  leaseToken      String?          @db.Uuid
  leaseUntil      DateTime?        @db.Timestamptz(6)
  consentedAt     DateTime?        @db.Timestamptz(6)
  id              String           @id @default(uuid()) @db.Uuid
  userId          String           @db.Uuid
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider        String           @db.VarChar(30)
  mode            String           @db.VarChar(10)
  status          String           @default("disconnected") @db.VarChar(20)
  tokenCiphertext String?          @db.Text
  cursor          String?          @db.VarChar(500)
  lastSyncAt      DateTime?        @db.Timestamptz(6)
  retryAt         DateTime?        @db.Timestamptz(6)
  createdAt       DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(6)
  records         ExternalRecord[]
  logs            SyncLog[]

  @@unique([id, userId])
  @@unique([userId, provider, mode])
}

model SyncLog {
  id           String        @id @default(uuid()) @db.Uuid
  userId       String        @db.Uuid
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectionId String        @db.Uuid
  connection   ApiConnection @relation(fields: [connectionId, userId], references: [id, userId], onDelete: Cascade, onUpdate: NoAction)
  status       String        @db.VarChar(20)
  recordCount  Int           @default(0)
  errorCode    String?       @db.VarChar(40)
  createdAt    DateTime      @default(now()) @db.Timestamptz(6)

  @@index([userId, connectionId, createdAt])
}

model ExternalRecord {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String        @db.Uuid
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectionId    String        @db.Uuid
  connection      ApiConnection @relation(fields: [connectionId, userId], references: [id, userId], onDelete: Cascade, onUpdate: NoAction)
  externalId      String        @db.VarChar(200)
  kind            String        @db.VarChar(30)
  payload         Json
  sourceUrl       String        @db.VarChar(500)
  sourceUpdatedAt DateTime      @db.Timestamptz(6)
  fetchedAt       DateTime      @default(now()) @db.Timestamptz(6)
  deleted         Boolean       @default(false)

  @@unique([userId, connectionId, externalId])
  @@index([userId, connectionId, fetchedAt])
}

model CsvImportBatch {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @db.Uuid
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId      String           @db.Uuid
  account        FinancialAccount @relation(fields: [accountId, userId], references: [id, userId], onDelete: Cascade, onUpdate: NoAction)
  digest         String           @db.VarChar(64)
  filename       String           @db.VarChar(120)
  currency       String           @db.Char(3)
  plan           Json
  rowCount       Int
  duplicateCount Int
  importedCount  Int              @default(0)
  skippedCount   Int              @default(0)
  importedAt     DateTime?        @db.Timestamptz(6)
  expiresAt      DateTime         @db.Timestamptz(6)
  createdAt      DateTime         @default(now()) @db.Timestamptz(6)
  keys           CsvImportKey[]
  transactions   Transaction[]

  @@unique([id, userId])
  @@unique([userId, accountId, digest])
  @@index([userId, createdAt])
}

model CsvImportKey {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @db.Uuid
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId   String           @db.Uuid
  account     FinancialAccount @relation(fields: [accountId, userId], references: [id, userId], onDelete: Cascade, onUpdate: NoAction)
  batchId     String           @db.Uuid
  batch       CsvImportBatch   @relation(fields: [batchId, userId], references: [id, userId], onDelete: Cascade, onUpdate: NoAction)
  externalKey String           @db.VarChar(64)
  payloadHash String           @db.VarChar(64)
  createdAt   DateTime         @default(now()) @db.Timestamptz(6)

  @@unique([userId, accountId, externalKey])
}

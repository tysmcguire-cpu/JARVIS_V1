{
  "name": "pluto",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:production": "playwright test --config playwright.production.config.ts",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "tsx scripts/pluto-migrate.ts",
    "db:provision": "tsx scripts/provision-owner.ts",
    "db:verify": "tsx scripts/verify-database.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:tracking": "tsx scripts/configure-tracking.ts",
    "db:verify-tracking": "tsx scripts/verify-tracking.ts",
    "db:telegram": "tsx scripts/configure-telegram.ts",
    "telegram:poll": "node --conditions=react-server --import tsx scripts/telegram-poll.ts",
    "telegram:replies": "node --conditions=react-server --import tsx scripts/telegram-poll.ts --replies-only",
    "db:verify-telegram": "tsx scripts/verify-telegram.ts",
    "telegram:identify": "node --conditions=react-server --import tsx scripts/telegram-identify.ts",
    "db:integrations": "tsx scripts/configure-integrations.ts",
    "db:verify-integrations": "tsx scripts/verify-integrations.ts",
    "db:assistant": "tsx scripts/configure-assistant.ts",
    "db:verify-assistant": "tsx scripts/verify-assistant.ts",
    "notifications:run": "node --conditions=react-server --import tsx scripts/notifications.ts",
    "db:notifications": "tsx scripts/configure-notifications.ts",
    "backup": "tsx scripts/backup.ts",
    "db:verify-release": "tsx scripts/verify-release.ts",
    "check:client-secrets": "tsx scripts/check-client-secrets.ts",
    "local": "next start --hostname 127.0.0.1",
    "hosted:start": "node --import tsx scripts/hosted-start.ts",
    "setup:preflight": "tsx scripts/pluto-preflight.ts",
    "setup:roles": "tsx scripts/pluto-provision-roles.ts",
    "setup:inspect": "tsx scripts/pluto-inspect-database.ts"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@prisma/client": "~6.19.0",
    "@radix-ui/react-slot": "^1.2.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.80.0",
    "@tiptap/markdown": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fast-xml-parser": "5.11.2",
    "ical.js": "2.2.1",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "stripe": "^23.0.0",
    "tailwind-merge": "^3.3.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "prisma": "~6.19.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.12"
  },
  "packageManager": "pnpm@11.25.0"
}
